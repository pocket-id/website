---
// The sponsor list loads after the page, so a row of empty avatars holds its place until it arrives
// starlight-llms-txt renders the page's content outside a page, where server islands can't render, so the AI text leaves the list out
import SponsorTiers from './SponsorTiers.astro';

const forLlms = /^\/llms[^/]*\.txt$/.test(Astro.url.pathname);
---

{
	!forLlms && (
		<SponsorTiers server:defer>
			<ul slot="fallback" class="not-content m-0 mt-8 flex list-none flex-wrap gap-2 p-0" aria-hidden="true">
				{Array.from({ length: 12 }, () => (
					<li class="m-0 size-12 animate-pulse rounded-full bg-surface-muted" />
				))}
			</ul>
		</SponsorTiers>
	)
}
