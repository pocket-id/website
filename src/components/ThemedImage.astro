---
// A logo with a light and a dark version, of which only the one matching the reader's theme shows
interface Props {
	light: string;
	dark: string;
	alt: string;
	href?: string;
	class?: string;
}
const { light, dark, alt, href, class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class="not-content my-6 flex justify-center">
	<img src={light} alt={alt} class:list={['dark:hidden', className]} />
	<img src={dark} alt={alt} class:list={['light:hidden', className]} />
</Tag>
