---
// A card per company that gives the project its tools for free, with its logo in the reader's theme
const tools = [
	{
		name: 'JetBrains',
		href: 'https://jb.gg/OpenSource',
		light: '/img/sponsors/jetbrains-light.svg',
		dark: '/img/sponsors/jetbrains-dark.svg',
		logo: 'h-8',
		text: 'Free All Products Pack subscriptions for open source maintainers.'
	},
	{
		name: 'Depot',
		href: 'https://depot.dev',
		light: '/img/sponsors/depot-light.svg',
		dark: '/img/sponsors/depot-dark.svg',
		logo: 'h-8',
		text: 'Fast CI/CD pipelines, free for open source projects.'
	},
	{
		name: 'Snyk',
		href: 'https://snyk.io',
		light: '/img/sponsors/snyk-light.svg',
		dark: '/img/sponsors/snyk-dark.svg',
		logo: 'h-14',
		text: 'Free licenses that help keep Pocket ID secure.'
	},
	{
		name: 'Vercel',
		href: 'https://vercel.com',
		light: '/img/sponsors/vercel-light.svg',
		dark: '/img/sponsors/vercel-dark.svg',
		logo: 'h-6',
		text: 'Free hosting for this website trough the Vercel OSS program.'
	},
	{
		name: 'OrbStack',
		href: 'https://orbstack.dev',
		light: '/img/sponsors/orbstack.png',
		dark: '/img/sponsors/orbstack.png',
		logo: 'h-10',
		wordmark: 'OrbStack',
		text: 'Free OrbStack Pro license for lightweight container development on macOS.'
	},
	{
		name: 'OpenAI',
		href: 'https://developers.openai.com/community/codex-for-oss',
		light: '/img/sponsors/openai-light.svg',
		dark: '/img/sponsors/openai-dark.svg',
		logo: 'h-6',
		text: 'Free Codex access through the Codex for Open Source program.'
	},
	{
		name: 'Anthropic',
		href: 'https://claude.com/contact-sales/claude-for-oss',
		light: '/img/sponsors/anthropic-light.svg',
		dark: '/img/sponsors/anthropic-dark.svg',
		logo: 'h-5',
		text: 'Free Claude Max access through the Claude for Open Source program.'
	}
];
---

<ul class="not-content m-0 mt-6 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2">
	{
		tools.map((t) => (
			<li class="m-0">
				<a
					href={t.href}
					target="_blank"
					rel="noopener"
					class="flex h-full flex-col gap-4 rounded-2xl border border-surface-border bg-surface p-5 no-underline [box-shadow:var(--surface-shadow)] transition-[border-color,translate] duration-200 hover:-translate-y-0.5 hover:border-gray-4"
				>
					<span class="flex h-14 items-center gap-3">
						<img src={t.light} alt={t.name} class:list={['w-auto dark:hidden', t.logo]} />
						<img src={t.dark} alt={t.name} class:list={['w-auto light:hidden', t.logo]} />
						{t.wordmark && <span aria-hidden="true" class="text-2xl font-semibold tracking-tight text-gray-1">{t.wordmark}</span>}
					</span>
					<span class="text-sm leading-relaxed text-gray-3">{t.text}</span>
				</a>
			</li>
		))
	}
</ul>
