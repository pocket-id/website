---
// How a workload authenticates as an OIDC client with a token from its own platform instead of a client secret
import Sequence from './Sequence.astro';

interface Props {
	caption?: string;
}
const {
	caption = 'The workload proves who it is with a token its platform issued. Pocket ID checks that token against the issuer, audience and subject you configured, so no client secret is stored anywhere.'
} = Astro.props;
---

<Sequence
	caption={caption}
	actors={[
		{ id: 'idp', title: 'Workload issuer', sub: 'Kubernetes, GitLab, Azure…' },
		{ id: 'app', title: 'Your app', sub: 'the OIDC client' },
		{ id: 'pid', title: 'Pocket ID', key: true }
	]}
	messages={[
		{ from: 'app', to: 'idp', label: 'requests a token' },
		{ from: 'idp', to: 'app', label: 'signed JWT' },
		{ from: 'app', to: 'pid', label: 'client_assertion = the JWT', key: true },
		{ from: 'pid', to: 'idp', label: 'signing keys from the JWKS URL', dashed: true },
		{ from: 'pid', to: 'pid', label: 'checks iss, aud and sub' },
		{ from: 'pid', to: 'app', label: 'access token' }
	]}
/>
