---
// The landing page's footer, with the mark, the license and a few places people look for next
import Logo from '../brand/Logo.astro';

const links = [
	{ href: '/docs/introduction', text: 'Docs' },
	{ href: '/changelog', text: 'Changelog' },
	{ href: 'https://github.com/pocket-id/pocket-id', text: 'GitHub' },
	{ href: '/docs/helping-out/sponsors', text: 'Sponsors' }
];
---

<footer class="border-t border-hairline">
	<div class="mx-auto flex max-w-[76rem] flex-col gap-6 px-5 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
		<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
			<a href="/" class="inline-flex items-center gap-2.5 text-fg no-underline">
				<Logo class="h-6 w-auto" />
				<span class="font-display text-[1.25rem] leading-none">Pocket ID</span>
			</a>
			<p class="m-0 text-xs text-gray-3">Open source under the BSD 2-Clause license.</p>
		</div>
		<nav aria-label="Footer">
			<ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0">
				{
					links.map((l) => (
						<li class="m-0">
							<a class="text-sm text-gray-3 no-underline transition-colors hover:text-fg" href={l.href}>
								{l.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</footer>
