---
// The landing page's header: the mark and the wordmark in the app's display face, the ways into the docs, GitHub and the theme switch
import Logo from '../brand/Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	stars?: string;
}
const { stars } = Astro.props;

const links = [
	{ href: '/docs/introduction', text: 'Docs' },
	{ href: '/docs/client-examples', text: 'Integrations' },
	{ href: '/changelog', text: 'Changelog' }
];
const link = 'inline-flex h-9 items-center gap-2 rounded-full px-3.5 text-sm font-medium text-gray-2 no-underline transition-colors hover:bg-surface-muted hover:text-fg';
---

<header class="sticky top-0 z-30 border-b border-hairline bg-[color-mix(in_oklch,var(--sl-color-black),transparent_20%)] backdrop-blur-xl">
	<div class="mx-auto flex h-16 max-w-[76rem] items-center justify-between gap-4 px-5 sm:px-6">
		<a href="/" class="inline-flex items-center gap-2.5 text-fg no-underline" aria-label="Pocket ID home">
			<Logo class="h-7 w-auto" />
			<span class="font-display text-[1.375rem] leading-none">Pocket ID</span>
		</a>
		<nav class="flex items-center gap-1" aria-label="Site">
			{links.map((l, i) => <a href={l.href} class:list={[link, i > 0 && 'max-md:hidden']}>{l.text}</a>)}
			<a href="https://github.com/pocket-id/pocket-id" class:list={[link, 'max-sm:px-2.5']} aria-label="Pocket ID on GitHub">
				<svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
					<path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z" />
				</svg>
				{stars && <span class="tabular-nums max-sm:hidden">{stars}</span>}
			</a>
			<ThemeToggle />
		</nav>
	</div>
</header>
