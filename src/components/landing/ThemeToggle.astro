---
// A round light, dark and auto switch that stores its choice the way Starlight does, so the docs and the landing page agree on the theme
import Monitor from '@lucide/astro/icons/monitor';
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';

interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<button
	type="button"
	class:list={[
		'grid size-9 cursor-pointer place-items-center rounded-full border-0 bg-transparent text-gray-2 transition-colors hover:bg-surface-muted hover:text-fg',
		className
	]}
	data-theme-toggle
	aria-label="Switch color theme"
	title="Switch color theme"
>
	<Sun class="hidden size-4.5" data-theme-icon="light" />
	<Moon class="hidden size-4.5" data-theme-icon="dark" />
	<Monitor class="size-4.5" data-theme-icon="auto" />
</button>

<script is:inline>
	(() => {
		// Starlight keeps 'light' or 'dark' under this key and an empty value for auto
		const key = 'starlight-theme';
		const order = ['auto', 'light', 'dark'];
		const stored = () => {
			const v = localStorage.getItem(key);
			return v === 'light' || v === 'dark' ? v : 'auto';
		};
		const preferred = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		const apply = (theme) => {
			document.documentElement.dataset.theme = theme === 'auto' ? preferred() : theme;
			document.querySelectorAll('[data-theme-icon]').forEach((el) => el.classList.toggle('hidden', el.dataset.themeIcon !== theme));
		};
		document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
			button.addEventListener('click', () => {
				const next = order[(order.indexOf(stored()) + 1) % order.length];
				localStorage.setItem(key, next === 'auto' ? '' : next);
				apply(next);
			});
		});
		matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
			if (stored() === 'auto') apply('auto');
		});
		apply(stored());
	})();
</script>
