---
// A light, dark and auto switch that stores its choice the way Starlight does, so the docs and the landing page agree on the theme
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<button
	type="button"
	class:list={[
		'inline-flex h-8.5 cursor-pointer items-center gap-2 rounded-lg border border-surface-border bg-surface px-2.5 font-sans text-sm leading-none font-medium text-fg [box-shadow:var(--surface-shadow)] hover:bg-gray-7',
		className
	]}
	data-theme-toggle
	aria-label="Switch color theme"
	title="Switch color theme"
>
	<svg class="dark:hidden" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4" />
		<path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
	</svg>
	<svg class="hidden dark:block" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
	</svg>
	<span data-theme-label>Auto</span>
</button>

<script is:inline>
	(() => {
		// Starlight keeps 'light' or 'dark' under this key and an empty value for auto
		const key = 'starlight-theme';
		const order = ['auto', 'light', 'dark'];
		const stored = () => {
			const v = localStorage.getItem(key);
			return v === 'light' || v === 'dark' ? v : 'auto';
		};
		const preferred = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		const apply = (theme) => {
			document.documentElement.dataset.theme = theme === 'auto' ? preferred() : theme;
			document.querySelectorAll('[data-theme-label]').forEach((el) => {
				el.textContent = theme[0].toUpperCase() + theme.slice(1);
			});
		};
		document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
			button.addEventListener('click', () => {
				const next = order[(order.indexOf(stored()) + 1) % order.length];
				localStorage.setItem(key, next === 'auto' ? '' : next);
				apply(next);
			});
		});
		matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
			if (stored() === 'auto') apply('auto');
		});
		apply(stored());
	})();
</script>
