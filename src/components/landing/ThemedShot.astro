---
// A card of Pocket ID on a landing page feature tile, in the reader's theme, from the landing-* captures of scripts/screenshots.mjs
// The captures are a single card on transparency at twice the size, and every card is shown at the same scale, so text is the same size on every tile
// It goes inside the tile's stage, centered in it, and a card taller than the stage starts at its top and fades out at its bottom edge
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	alt: string;
}
const { name, alt } = Astro.props;

const screens = import.meta.glob<{ default: ImageMetadata }>('../../assets/screens/landing-*.png', { eager: true });
const pick = (theme: 'light' | 'dark') => {
	const image = screens[`../../assets/screens/landing-${name}-${theme}.png`];
	if (!image) throw new Error(`Missing screenshot src/assets/screens/landing-${name}-${theme}.png`);
	return image.default;
};
const light = pick('light');
const dark = pick('dark');

const scale = 0.66;
const width = Math.round((light.width / 2) * scale);
const widths = [width, width * 2];
const sizes = `${width}px`;
const image = 'mx-auto block h-auto max-w-full shrink-0';
---

<div class="absolute inset-0 flex flex-col px-3 py-5 [justify-content:safe_center] [mask-image:linear-gradient(to_bottom,black_calc(100%-2rem),transparent)]">
	<Image src={light} {alt} {widths} {sizes} loading="lazy" class:list={[image, 'dark:hidden']} style={`width: ${width}px`} />
	<Image src={dark} {alt} {widths} {sizes} loading="lazy" class:list={[image, 'light:hidden']} style={`width: ${width}px`} />
</div>
