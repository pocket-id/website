---
// The docs header: the site title, the main sections as links next to it, and search, social links and the theme switch on the right
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from './SocialIcons.astro';
import ThemeSelect from './ThemeSelect.astro';

const links = [
	{ href: '/docs/client-examples', text: 'Client examples' },
	{ href: '/docs/api', text: 'REST API' },
	{ href: '/changelog', text: 'Changelog' }
];

// A link is current on its own page and on the pages below it, such as a single client example
const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="header-nav sl-hidden md:sl-flex print:hidden" aria-label="Sections">
		{
			links.map((l) => (
				<a class="header-link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
					{l.text}
				</a>
			))
		}
	</nav>
	<div class="header-end sl-flex print:hidden">
		<Search />
		<div class="sl-hidden md:sl-flex right-group">
			<SocialIcons />
			<ThemeSelect />
		</div>
	</div>
</div>

<style>
	.header {
		display: flex;
		align-items: center;
		gap: var(--sl-nav-gap);
		height: 100%;
	}
	.title-wrapper {
		/* Long titles must not cover the search and menu buttons on narrow viewports */
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}
	/* On wide screens with a sidebar, the links start where the content column does */
	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) .title-wrapper {
			flex-shrink: 0;
			width: calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x) - var(--sl-nav-gap) + 0.25rem);
		}
	}
	.header-nav {
		align-items: center;
		gap: 0.25rem;
	}
	.header-link {
		display: inline-flex;
		align-items: center;
		height: 2.25rem;
		padding: 0 0.875rem;
		border-radius: 999px;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.header-link:hover,
	.header-link[aria-current='page'] {
		background-color: var(--surface-muted);
		color: var(--sl-color-white);
	}
	.header-end {
		flex: 1;
		justify-content: flex-end;
		align-items: center;
		gap: 1rem;
		min-width: 0;
	}
	.right-group {
		align-items: center;
		gap: 0.75rem;
	}
	.header-end :global(site-search) {
		flex: 0 1 20rem;
	}
</style>
