---
// A single round button that switches between the light and the dark theme, like the app's, instead of Starlight's select
// It stores the choice under Starlight's key, so the docs, the landing page and Starlight's theme provider agree
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
---

<button type="button" class="theme-toggle" data-docs-theme-toggle aria-label="Switch between light and dark theme" title="Switch theme">
	<Moon class="theme-icon theme-icon-moon" />
	<Sun class="theme-icon theme-icon-sun" />
</button>

<script>
	// Every toggle on the page, the header's and the mobile menu's, switches to the theme that isn't showing
	document.querySelectorAll<HTMLButtonElement>('[data-docs-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
			document.documentElement.dataset.theme = next;
			localStorage.setItem('starlight-theme', next);
		});
	});
</script>

<style>
	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}
	.theme-toggle:hover {
		background-color: var(--surface-muted);
		color: var(--sl-color-white);
	}
	.theme-toggle :global(.theme-icon) {
		width: 1.125rem;
		height: 1.125rem;
	}
	/* The button shows the theme it switches to */
	:global([data-theme='dark']) .theme-toggle :global(.theme-icon-moon),
	:global([data-theme='light']) .theme-toggle :global(.theme-icon-sun) {
		display: none;
	}
</style>
